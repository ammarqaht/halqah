// Halqah — schema. Mirrors SPEC.md §3. Only the tables behind screens that
// exist today; exams, points, store and curriculum arrive with their screens.

generator client {
  provider      = "prisma-client-js"
  // The runtime image is alpine (musl). Naming the target explicitly stops the
  // client from looking for a glibc engine that is not there.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Track {
  TALQEEN
  SILVER
  GOLDEN
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum IdFlag {
  SHORT
  LONG
  DUPLICATE
}

enum AdminRole {
  SUPERVISOR
}

model AdminUser {
  id           String   @id @default(cuid())
  fullName     String   @map("full_name")
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         AdminRole @default(SUPERVISOR)
  active       Boolean  @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")

  audits AuditLog[]
  @@map("admin_users")
}

model Halaqa {
  id        String   @id @default(cuid())
  name      String   @unique
  teacher   String
  mosque    String   @default("جامع محمد العبدالكريم — حي أُحد")
  timeSlot  String   @default("العصر") @map("time_slot")
  // A default for newly added students only. The track is the STUDENT's — a
  // halaqa may hold several — and this is never applied to an existing roster.
  track     Track?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  students Student[]

  @@index([mosque, timeSlot])
  @@map("halaqat")
}

model Student {
  id       String @id @default(cuid())
  fullName String @map("full_name")

  // Stored exactly as found: abs() of the roster value, no length validation.
  // NOT unique — the client's roster legitimately carries one id on two rows.
  nationalId     String? @map("national_id")
  nationalIdFlag IdFlag? @map("national_id_flag")

  // Stable identity across re-imports; the parser suffixes a repeated id.
  dedupeKey String? @unique @map("dedupe_key")

  track         Track?
  halaqaId      String?       @map("halaqa_id")
  grade         String        @default("")
  stage         String        @default("")
  nationality   String        @default("")
  guardianPhone String        @default("") @map("guardian_phone")
  status        StudentStatus @default(ACTIVE)
  currentLevel  Int?          @map("current_level")

  // last snapshot from a Ratel import
  /** «الحضور» is a COUNT OF DAYS in the roster — 0 to 7 — not a yes/no.
      Read as a boolean, a boy present three days out of three came back «غائب». */
  attendedDays Int?    @map("attended_days") 
  hifzPages   Decimal? @map("hifz_pages")   @db.Decimal(6, 2)
  reviewPages Decimal? @map("review_pages") @db.Decimal(6, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  halaqa    Halaqa?          @relation(fields: [halaqaId], references: [id], onDelete: SetNull)
  transfers HalaqaTransfer[]

  @@index([halaqaId])
  @@index([track])
  @@index([status])
  @@index([nationalId])
  @@map("students")
  /* Everything a student accumulates, now that it lives in the database. */
  txns        PointTxn[]
  orders      Order[]
  exams       Exam[]
  bookings    ExamBooking[]
  plans       StudentPlan[]
}

model HalaqaTransfer {
  id           String   @id @default(cuid())
  studentId    String   @map("student_id")
  fromHalaqaId String?  @map("from_halaqa_id")
  toHalaqaId   String?  @map("to_halaqa_id")
  reason       String?
  movedAt      DateTime @default(now()) @map("moved_at")
  movedBy      String?  @map("moved_by")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, movedAt])
  @@map("halaqa_transfers")
}

model ImportRun {
  id         String   @id @default(cuid())
  fileName   String   @map("file_name")
  sheetName  String   @map("sheet_name")
  kind       String
  rowCount   Int      @map("row_count")
  created    Int      @default(0)
  updated    Int      @default(0)
  flagged    Int      @default(0)
  skipped    Int      @default(0)
  importedBy String?  @map("imported_by")
  importedAt DateTime @default(now()) @map("imported_at")

  @@index([importedAt])
  @@map("import_runs")
}

// Every edit the supervisor makes. §13.10: no edit window, and everything logged.
model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?  @map("actor_id")
  action   String
  entity   String
  entityId String?  @map("entity_id")
  before   Json?
  after    Json?
  at       DateTime @default(now())

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, at])
  @@map("audit_log")
}

// Rules live here, never hard-coded in application code. SPEC.md §3.8
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/* ─────────────────────────────────────────────────────────────────────────────
   Everything below lived in the browser alone.

   Eleven entities — the whole points ledger, every exam, every plan, the
   curriculum, the store and its orders — were held in localStorage. That is not
   a sync problem so much as a durability one: the supervisor's work existed in
   one browser profile on one machine, and clearing site data or opening the
   system on the phone showed an empty system.

   They are tables now, with the foreign keys that make them one system rather
   than eleven lists that happen to share ids.
   ───────────────────────────────────────────────────────────────────────── */

/** §3.5 — append-only. A balance is the sum of its rows, never a column. */
model PointTxn {
  id        String   @id
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  delta     Int
  kind      String
  reason    String   @default("")
  refType   String?  @map("ref_type")
  refId     String?  @map("ref_id")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([studentId])
  @@index([refType, refId])
  @@map("point_txns")
}

model PointCodeBatch {
  id        String      @id
  value     Int
  purpose   String      @default("")
  quantity  Int
  expiresAt DateTime?   @map("expires_at")
  revokedAt DateTime?   @map("revoked_at")
  createdBy String?     @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")
  codes     PointCode[]

  @@map("point_code_batches")
}

model PointCode {
  id         String         @id
  batchId    String         @map("batch_id")
  batch      PointCodeBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /** Ten characters, random — never sequential, or the next card is guessable. */
  code       String         @unique
  redeemedBy String?        @map("redeemed_by")
  redeemedAt DateTime?      @map("redeemed_at")

  @@index([batchId])
  @@map("point_codes")
}

model Gift {
  id                String   @id
  name              String
  description       String   @default("")
  /** A data URL until an object store exists — lib/image.ts downscales it. */
  image             String?
  pointsCost        Int      @map("points_cost")
  quantity          Int
  lowStockThreshold Int      @default(3) @map("low_stock_threshold")
  category          String   @default("")
  status            String   @default("VISIBLE")
  createdAt         DateTime @default(now()) @map("created_at")
  orders            Order[]

  @@map("gifts")
}

model Order {
  id               String    @id
  /** Short, human, and quotable at the desk: «رقم طلبي ٧٣». */
  number           Int       @unique
  studentId        String    @map("student_id")
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  giftId           String    @map("gift_id")
  gift             Gift      @relation(fields: [giftId], references: [id])
  /** Snapshots: the gift's price and name may change, what he paid may not. */
  pointsSpent      Int       @map("points_spent")
  giftNameSnapshot String    @map("gift_name_snapshot")
  status           String    @default("PENDING")
  createdAt        DateTime  @default(now()) @map("created_at")
  deliveredAt      DateTime? @map("delivered_at")
  cancelledReason  String?   @map("cancelled_reason")

  @@index([studentId])
  @@index([status])
  @@map("orders")
}

model Exam {
  id            String         @id
  studentId     String         @map("student_id")
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /** Denormalised deliberately: a student may move halaqa later, and the
      record of who examined him must not move with him. */
  halaqaId      String?        @map("halaqa_id")
  track         String?
  type          String
  takenOn       String         @map("taken_on")
  level         Int?
  ajza          Int?
  errors        Int?
  warnings      Int?
  tajweedErrors Int?           @map("tajweed_errors")
  score         Int?
  passed        Boolean?
  pointsAwarded Int            @default(0) @map("points_awarded")
  pointsPaid    Boolean        @default(false) @map("points_paid")
  note          String         @default("")
  examiner      String         @default("")
  /** One sitting, several rules — a tajweed exam covers as many as were set. */
  tajweedTopics String[]       @map("tajweed_topics")
  source        String         @default("MANUAL")
  createdAt     DateTime       @default(now()) @map("created_at")
  questions     ExamQuestion[]

  @@index([studentId])
  @@index([takenOn])
  @@map("exams")
}

model ExamQuestion {
  id            String @id
  examId        String @map("exam_id")
  exam          Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  seq           Int
  surah         String @default("")
  ayahFrom      String @default("") @map("ayah_from")
  ayahTo        String @default("") @map("ayah_to")
  errors        Int    @default(0)
  warnings      Int    @default(0)
  tajweedErrors Int    @default(0) @map("tajweed_errors")
  note          String @default("")

  @@index([examId])
  @@map("exam_questions")
}

model ExamBooking {
  id          String   @id
  studentId   String   @map("student_id")
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scheduledOn String   @map("scheduled_on")
  level       Int?
  badge       String
  status      String   @default("BOOKED")
  examId      String?  @map("exam_id")
  note        String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([scheduledOn])
  @@index([studentId])
  @@map("exam_bookings")
}

/** Reference data — one row per (track, level, day, kind). */
model CurriculumDay {
  track     String
  level     Int
  dayNo     Int    @map("day_no")
  kind      String
  fromSurah String @default("") @map("from_surah")
  fromAyah  String @default("") @map("from_ayah")
  toSurah   String @default("") @map("to_surah")
  toAyah    String @default("") @map("to_ayah")
  note      String @default("")

  @@id([track, level, dayNo, kind])
  @@index([track, level])
  @@map("curriculum_days")
}

model StudentPlan {
  id           String            @id
  studentId    String            @map("student_id")
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  track        String
  level        Int
  issuedAt     String            @map("issued_at")
  issuedBy     String?           @map("issued_by")
  dayCount     Int               @default(24) @map("day_count")
  examDays     Json              @map("exam_days")
  dailyAmount  String            @default("") @map("daily_amount")
  printedCount Int               @default(0) @map("printed_count")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@unique([studentId, track, level])
  @@index([studentId])
  @@map("student_plans")
}


model TajweedTopic {
  id     String  @id
  name   String  @unique
  active Boolean @default(true)

  @@map("tajweed_topics")
}
