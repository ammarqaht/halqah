# Halqah — environment.
# Copy to .env.local for development. Set the same keys in CranL for production.
# .env* is gitignored: these values never enter version control.

# From CranL → Applications → your PostgreSQL database → Connection Information
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Signs the session cookie. Generate one with:  openssl rand -base64 48
AUTH_SECRET=""
